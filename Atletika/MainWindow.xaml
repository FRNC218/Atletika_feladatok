<Window x:Class="Atletika.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Atletika"
        mc:Ignorable="d"
        Title="MainWindow" Height="750" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Fejléc: tartalomhoz igazodik -->
            <RowDefinition Height="Auto"/>
            <!-- Középső rész: kitölti a maradék helyet -->
            <RowDefinition Height="*"/>
            <!-- Lábléc: tartalomhoz igazodik -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <!-- Bal oldali oszlop szélessége 390 -->
            <ColumnDefinition Width="390"/>
            <!-- Jobb oldali oszlop kitölti a maradék helyet -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- FEJLÉC -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
            <TextBlock Text="Atlétikai verseny" FontSize="28" FontWeight="Bold" Foreground="#19324D"/>
            <TextBlock Text="Versenyzők regisztrációja és rajtszámok kiosztása" Foreground="#52657A" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- BAL OLDAL: Adatbeviteli panel -->
        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#D4DDE7" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,20,16">
            <StackPanel>
                <TextBlock Text="Új versenyző" FontWeight="Bold" FontSize="16" Foreground="#19324D" Margin="0,0,0,12"/>

                <!-- Név -->
                <TextBlock Text="Versenyző neve:" Margin="0,0,0,4"/>
                <TextBox x:Name="txtNev" Height="32" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

                <!-- Versenyszám -->
                <TextBlock Text="Versenyszám:" Margin="0,0,0,4"/>
                <ComboBox x:Name="cmbVersenyszam" Height="32" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                    <ComboBoxItem Content="100 m"/>
                    <ComboBoxItem Content="200 m"/>
                    <ComboBoxItem Content="400 m"/>
                    <ComboBoxItem Content="800 m"/>
                    <ComboBoxItem Content="1500 m"/>
                    <ComboBoxItem Content="Távolugrás"/>
                    <ComboBoxItem Content="Magasugrás"/>
                    <ComboBoxItem Content="Súlylökés"/>
                </ComboBox>

                <!-- Nem -->
                <TextBlock Text="Nem:" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="rbFerfi" Content="Férfi" GroupName="Nem" Margin="0,0,20,0"/>
                    <RadioButton x:Name="rbNo" Content="Nő" GroupName="Nem"/>
                </StackPanel>

                <!-- Életkor -->
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="Életkor:" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="txtEletkor" Text="{Binding ElementName=sldEletkor, Path=Value}" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="sldEletkor" Minimum="18" Maximum="90" Value="18" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" />
                <Grid Margin="0,2,0,12">
                    <TextBlock Text="18" FontSize="11" Foreground="Gray" HorizontalAlignment="Left"/>
                    <TextBlock Text="90" FontSize="11" Foreground="Gray" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Korábbi eredmények -->
                <TextBlock Text="Korábbi eredmények" FontWeight="Bold" Foreground="#19324D" Margin="0,0,0,8"/>
                <CheckBox x:Name="chkolimpiai" Content="Olimpiai csúcs" Margin="0,0,0,6"/>
                <CheckBox x:Name="chkVB" Content="Világbajnoki csúcs" Margin="0,0,0,6"/>
                <CheckBox x:Name="chkEB" Content="Európa-bajnoki csúcs" Margin="0,0,0,16"/>

                <!-- Igényelt rajtszám -->
                <TextBlock Text="Igényelt rajtszám:" Margin="0,0,0,4"/>
                <TextBox x:Name="txtRajtszam" Height="32" VerticalContentAlignment="Center"/>
                <TextBlock Text="Üres mező: automatikus kiosztás" FontSize="11" Foreground="Gray" Margin="0,2,0,16"/>

                <!-- REGISZTRÁL gomb -->
                <Button x:Name="btnRegisztral" Content="REGISZTRÁL" Height="36" Background="#DDEBFA" BorderBrush="#D4DDE7" Click="Regisztral_Click" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- JOBB OLDAL: Lista -->
        <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#D4DDE7" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Regisztrált versenyzők" FontWeight="Bold" FontSize="16" Foreground="#19324D" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Text="Rajtszám | Név | Versenyszám | Nem | Kor | O | VB | EB" Foreground="Gray" Margin="0,0,0,6"/>

                <ListBox x:Name="lstVersenyzok" Grid.Row="2" BorderBrush="#D4DDE7" BorderThickness="1" Padding="6"/>

                <TextBlock Grid.Row="3" Text="O = olimpiai, VB = világbajnoki, EB = Európa-bajnoki csúcs" FontSize="11" Foreground="Gray" Margin="0,6,0,0"/>
            </Grid>
        </Border>

        <!-- LÁBLÉC -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="White" BorderBrush="#D4DDE7" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <TextBlock x:Name="txtLetszam" Text="Regisztrált versenyzők: 0" VerticalAlignment="Center" HorizontalAlignment="Left" FontWeight="Bold"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnMentes" Content="FÁJLBA MENTÉS" Width="210" Height="32" Margin="0,0,16,0" Click="Mentes_Click"/>
                    <Button x:Name="btnBetoltes" Content="FÁJLBÓL BETÖLTÉS" Width="210" Height="32" Click="Betoltes_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
